<!--
  Currency Field Template

  File path: force-app/main/default/objects/OBJECT_NAME__c/fields/FIELD_NAME__c.field-meta.xml

  Replace:
    - FIELD_NAME: API name without __c suffix (e.g., "Offer_Amount")
    - FIELD_LABEL: Human-readable label (e.g., "Offer Amount")

  Attributes:
    - precision: Total number of digits (max 18). Includes digits before AND after decimal.
    - scale: Number of decimal places (typically 2 for currency)
    - required: true/false — if true, no FLS entry needed in Admin profile

  REMEMBER: If required is false, you MUST add an FLS entry in Admin.profile-meta.xml.
-->
<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FIELD_NAME__c</fullName>
    <label>FIELD_LABEL</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
