<?xml version="1.0" encoding="UTF-8"?>
<!-- File path: force-app/main/default/objects/<ObjectName>/webLinks/<ButtonName>.webLink-meta.xml -->
<!-- WebLink = custom button or custom link on an object -->
<WebLink xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BUTTON_NAME</fullName>
    <availability>online</availability>
    <displayType>button</displayType>
    <!-- encodingKey is REQUIRED — deploy fails without it -->
    <encodingKey>UTF-8</encodingKey>
    <hasMenubar>false</hasMenubar>
    <hasScrollbars>true</hasScrollbars>
    <hasToolbar>false</hasToolbar>
    <height>600</height>
    <isResizable>true</isResizable>
    <!-- linkType: url (URL button), javascript (JS button), sControl -->
    <linkType>url</linkType>
    <masterLabel>Button Label</masterLabel>
    <!-- openType: newWindow, sidebar, noSidebar, replace, onClickJavaScript -->
    <openType>newWindow</openType>
    <position>none</position>
    <protected>false</protected>
    <showsLocation>false</showsLocation>
    <showsStatus>false</showsStatus>
    <!-- Use merge fields like {!Object.Field} in the URL -->
    <url>https://www.google.com/search?q={!Contact.Name}</url>
</WebLink>
